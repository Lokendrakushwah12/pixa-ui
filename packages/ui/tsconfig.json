{
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@pixa/ui/*": ["./src/*"]
    },
    "types": ["next", "react", "node", "bun-types"]
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/fluid",
    "src/components/fluid"
  ],
  "extends": "@pixa/typescript-config/react-library.json",
  "include": ["."]
}
